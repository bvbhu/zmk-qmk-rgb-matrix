# RGB Matrix — Zephyr Kconfig
# 所有 RGB Matrix 参数通过 Kconfig 定义，由 snippet 自动生成
# rgb_matrix_generated_config.h 注入编译。

menuconfig ZMK_RGB_MATRIX
    bool "Enable QMK-style RGB Matrix (ZMK module)"
    default y
    help
      Enable QMK-style RGB Matrix effect engine as a ZMK module.

if ZMK_RGB_MATRIX

menu "RGB Matrix Configuration"

config RGB_MATRIX_ROWS
    int "Matrix rows"
    default 5
    help
      Number of rows in the keyboard matrix.

config RGB_MATRIX_COLS
    int "Matrix columns"
    default 15
    help
      Number of columns in the keyboard matrix.

config RGB_MATRIX_LED_COUNT
    int "LED count"
    default 69
    help
      Total number of RGB LED pixels on the keyboard.

config RGB_MATRIX_CENTER_X
    int "LED center X coordinate (0-255)"
    default 108
    help
      X center point of the LED coordinate system for symmetric effects.

config RGB_MATRIX_CENTER_Y
    int "LED center Y coordinate (0-255)"
    default 32
    help
      Y center point of the LED coordinate system for symmetric effects.

config RGB_MATRIX_LED_FLUSH_LIMIT
    int "LED flush interval (ms)"
    default 16
    range 1 100
    help
      Interval in milliseconds between LED buffer flushes.

config RGB_WORKQ_STACK_SIZE
    int "RGB workqueue stack size (bytes)"
    default 2048
    range 0 4096
    help
      If > 0, use a dedicated workqueue for RGB rendering.
      If 0, use the system workqueue (saves RAM).

config RGB_MATRIX_HUE_STEP
    int "Hue step"
    default 8
    range 1 255

config RGB_MATRIX_SAT_STEP
    int "Saturation step"
    default 16
    range 1 255

config RGB_MATRIX_VAL_STEP
    int "Value (brightness) step"
    default 16
    range 1 255

config RGB_MATRIX_SPD_STEP
    int "Speed step"
    default 16
    range 1 255

config RGB_MATRIX_MAXIMUM_BRIGHTNESS
    int "Maximum brightness"
    default 225
    range 1 255

config RGB_MATRIX_SETTINGS_SAVE_DEBOUNCE
    int "Settings save debounce delay (ms)"
    default 5000
    help
      Debounce for saving RGB settings to Flash.
      Positive: trailing-edge debounce; 0: write immediately; negative: disable.

config RGB_MATRIX_DEFAULT_HSV
    string "Default HSV (hue, sat, val)"
    default "170, 255, 200"
    help
      Default HSV color when no valid settings are loaded.

config RGB_MATRIX_DEFAULT_SPD
    int "Default animation speed (0-255)"
    default 127
    range 0 255

config RGB_MATRIX_DEFAULT_ON
    bool "Default RGB on at startup"
    default y

config RGB_MATRIX_DEFAULT_MODE
    string "Default effect mode"
    default "CYCLE_LEFT_RIGHT"
    help
      Effect name without RGB_MATRIX_ prefix, e.g. CYCLE_LEFT_RIGHT.

config RGB_MATRIX_KEEP_ON_WIRED
    bool "Keep RGB on when wired (USB powered)"
    default n
    help
      If enabled, RGB stays on in wired mode regardless of idle timeout.
      Wireless mode still obeys CONFIG_ZMK_IDLE_TIMEOUT.

config RGB_LED_CONFIG_CONST
    bool "Declare g_led_config as const"
    default n
    help
      If enabled, g_led_config is declared const in rgb_matrix.h.
      The keyboard's keymap.c must also define g_led_config as const.
      Useful on RAM-constrained MCUs (e.g. STM32F072) to place the
      LED layout in flash rather than RAM.

endmenu

